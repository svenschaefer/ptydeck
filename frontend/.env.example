# Required integer 1..65535
FRONTEND_PORT=18081
# Optional explicit overrides. Leave empty to auto-derive from browser host.
# Must be http/https URL when set.
API_BASE_URL=
# Must be ws/wss URL when set.
WS_URL=
# Optional canonical browser origin. When set, non-canonical opens redirect here first.
FRONTEND_CANONICAL_ORIGIN=
FRONTEND_DEBUG_LOGS=0
